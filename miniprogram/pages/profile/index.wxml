<view class="main profile-main"><view class="brand-lockup"><image class="brand-mark" mode="aspectFit" src="/assets/pig-chef-avatar.png"/><text class="brand-name">猪什么</text></view><view class="row profile-head"><image class="avatar" mode="aspectFill" src="{{profile.avatar}}"/><view><text class="eyebrow">自己的厨房，自己的节奏</text><text class="h">{{profile.name}}</text><button class="link" bindtap="edit">编辑资料 ›</button></view></view><view wx:if="{{editing}}" class="card"><text class="b">编辑资料</text><image class="avatar avatar-preview" mode="aspectFill" src="{{draftAvatar || profile.avatar}}"/><input type="nickname" class="input" value="{{draftName}}" bindinput="name" placeholder="请输入名字"/><view class="profile-edit-actions"><button open-type="chooseAvatar" bindchooseavatar="avatar" class="btn secondary">选择头像</button><button class="btn" bindtap="save">保存资料</button></view><button class="link" bindtap="cancel">取消</button></view><view class="card"><text class="b">我的下厨成就</text><view class="stats"><view bindtap="menu"><text class="count">{{mealCount}}</text><text class="small">完成的餐</text></view><view bindtap="menu"><text class="count">{{dishCount}}</text><text class="small">做好的菜</text></view><view bindtap="menu"><text class="count">{{favorites}}</text><text class="small">收藏的菜谱</text></view></view></view><view class="card"><view class="row divider" bindtap="fridge"><text>我的冰箱</text><text>›</text></view><view class="row divider" bindtap="library"><text>菜谱大全</text><text>›</text></view><view class="row divider" bindtap="friends"><text>我的好友</text><text>›</text></view></view><view class="agreement-entry" bindtap="agreement"><text class="small">用户协议</text><text class="small">›</text></view><text class="small" style="text-align:center">猪什么 · 慢慢学，好好吃</text></view>






