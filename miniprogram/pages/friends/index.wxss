.page{min-height:100vh;padding:40rpx 32rpx 72rpx;background:#faf8f2}.title{display:block;font-size:46rpx;line-height:1.4;font-weight:700;color:#26332d}.muted{display:block;color:#7b877d;font-size:25rpx;line-height:1.7;margin-top:10rpx}.notice{padding:22rpx;margin-top:24rpx;background:#fff4df;border:2rpx solid #f0d39b;border-radius:18rpx;color:#8a6a27;font-size:24rpx;line-height:1.6}.card{margin-top:24rpx;padding:10rpx 24rpx;background:#fff;border:2rpx solid #e1e6d9;border-radius:28rpx;box-shadow:0 10rpx 30rpx rgba(58,79,54,.05)}.friend{display:flex;gap:18rpx;align-items:center;padding:22rpx 0;border-bottom:1rpx solid #edf0ea}.friend:last-child{border:0}.avatar{width:70rpx;height:70rpx;border-radius:50%;background:#dfe8d7;color:#557151;text-align:center;line-height:70rpx;font-size:30rpx}.name{display:block;font-size:29rpx;font-weight:600}.meta{display:block;color:#7b877d;font-size:23rpx;margin-top:8rpx}.empty{text-align:center;color:#7b877d;padding:70rpx 20rpx;line-height:2}.primary{width:100%;margin-top:26rpx;background:#537348;color:#fff;border-radius:22rpx;min-height:92rpx;line-height:92rpx}

.card>text{display:block;line-height:1.7;margin:14rpx 0}.card>button{margin:16rpx 0;font-size:26rpx}
.consent{display:flex;align-items:center;font-size:23rpx;color:#7b877d;line-height:1.6}.consent checkbox{transform:scale(.75)}.code-entry{display:flex;align-items:center;gap:12rpx;margin-top:32rpx;background:#fff;padding:16rpx;border-radius:18rpx}.code-entry input{flex:1;min-width:0;font-size:24rpx}.link{background:transparent;color:#7b877d;font-size:24rpx}.link::after{border:0}.error{font-size:24rpx;color:#986323;margin-top:20rpx}

.add-friend{margin-top:28rpx;color:#537348;background:#eef3e8;border-radius:22rpx;font-size:28rpx}.code-mask{position:fixed;top:0;right:0;bottom:0;left:0;z-index:1000;background:rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;padding:32rpx;box-sizing:border-box}.code-dialog{width:100%;max-width:620rpx;box-sizing:border-box;background:#fffdf8;border-radius:28rpx;padding:32rpx}.code-input{display:block;width:100%;height:132rpx;box-sizing:border-box;margin-top:24rpx;padding:20rpx;border:2rpx solid #dce4d5;border-radius:16rpx;background:#fff;font-size:26rpx;line-height:38rpx;word-break:break-all}

.friend-card:active{background:#f2f6ed}.friend-actions{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:12rpx}.view-menu{flex:1;background:#eef3e8;color:#537348;border-radius:14rpx;font-size:25rpx;margin:0;padding:0 16rpx}.view-menu::after{border:0}.friend-actions .link{margin:0;flex-shrink:0}

.friend-card{display:block}.friend-card-active{background:#f2f6ed}.friend-actions .view-menu{display:block;text-align:center;line-height:72rpx;min-height:72rpx}.version{display:block;text-align:center;margin-top:32rpx;color:#a0a89d;font-size:22rpx}

.dialog-title{display:block;font-size:34rpx;line-height:48rpx;font-weight:600;color:#26332d}.code-dialog .error{display:block;margin-top:14rpx;line-height:36rpx}.code-actions{display:flex;align-items:stretch;gap:20rpx;margin-top:28rpx}.code-actions button{display:block;flex:1;width:0;min-width:0;max-width:none;height:88rpx;min-height:88rpx;line-height:88rpx;margin:0;padding:0 16rpx;border-radius:18rpx;font-size:28rpx;font-weight:500;box-sizing:border-box}.code-actions button::after{border:0}.code-actions .code-cancel{background:#edf1e8;color:#52634f}.code-actions .code-next{background:#537348;color:#fff}.code-actions .code-next[disabled]{background:#bdc9b5;color:#fff}

.page{box-sizing:border-box;padding:32rpx 32rpx 64rpx}.title{font-size:42rpx;margin-bottom:28rpx}.card{padding:24rpx;border-radius:24rpx}.page .primary,.page .add-friend{display:flex;align-items:center;justify-content:center;width:100%;max-width:none;box-sizing:border-box;min-height:88rpx;padding:18rpx 24rpx;line-height:1.5;font-size:28rpx;font-weight:600;margin-left:0;margin-right:0;border-radius:20rpx;white-space:normal}.page button::after{border:0}.page .add-friend{margin-top:18rpx}.invitation-card>.name{font-size:32rpx;margin:0 0 10rpx}.invitation-card>.meta{font-size:26rpx;margin:0;line-height:1.6}.invitation-actions{display:flex;gap:16rpx;margin-top:24rpx;align-items:stretch}.invitation-actions .primary,.invitation-actions .link{flex:1;width:0;min-width:0;margin:0;min-height:88rpx;display:flex;align-items:center;justify-content:center;padding:16rpx;line-height:1.5;font-size:28rpx;border-radius:18rpx}.invitation-actions .link{background:#eef3e8;color:#537348}.friend>view{flex:1;min-width:0}.friend .name,.friend .meta{overflow-wrap:break-word;line-height:1.6}.avatar{flex-shrink:0}.friend-actions .link{min-height:72rpx;line-height:72rpx;padding:0 16rpx}.version{margin-top:28rpx}.code-actions .primary{margin:0;width:0;min-height:88rpx}
