<view class="main"><text class="eyebrow">搭配你的一餐</text><text class="h">先定人数与菜数</text><view class="card"><view class="row"><text class="b">几个人吃？</text><text class="count">{{people}}人</text></view><slider min="1" max="10" value="{{people}}" activeColor="#537348" bindchanging="people" bindchange="people"/><view class="row"><text class="b">做几道菜？</text><text class="count">{{count}}道</text></view><slider min="1" max="10" value="{{count}}" activeColor="#537348" bindchanging="count" bindchange="count"/></view><text class="h">今天想吃什么口味？</text><view class="card"><view wx:for="{{groups}}" wx:key="key" class="taste-group taste-{{item.key}}"><text class="b taste-title">{{item.label}}</text><view class="tags taste-options"><button wx:for="{{item.options}}" wx:for-item="option" wx:key="*this" class="tag {{prefs[item.key]===option?'selected':''}}" data-key="{{item.key}}" data-value="{{option}}" bindtap="taste">{{option}}</button></view></view><checkbox-group class="pantry-mode" bindchange="pantryMode"><label class="pantry-choice"><checkbox value="strict" checked="{{strictPantry}}" color="#537348"/><text>仅用冰箱食材</text></label></checkbox-group></view><view wx:if="{{error}}" class="warning generation-notice"><text class="generation-notice-text">{{error}}</text></view><button class="btn" bindtap="generate">生成菜单 →</button></view>


