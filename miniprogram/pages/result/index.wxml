<view wx:if="{{error}}" class="main"><text class="h">菜单暂不可用</text><text class="small">{{error}}</text><button class="btn" bindtap="backWizard">返回</button></view><block wx:else><view class="main"><text class="eyebrow">为你搭配的一餐</text><text class="h">{{meal.title}}</text><text class="small">匹配到{{items.length}}道菜<text wx:if="{{timeKnown}}"> · 约{{minutes}}分钟</text></text><text wx:if="{{meal.preferences && meal.preferences.__blind}}" class="small blind-hint">盲盒随机菜谱 · 不受冰箱食材限制</text><view wx:if="{{!items.length}}" class="warning"><text class="b">暂时没有符合条件的菜</text><text class="small">可以返回调整人数、口味或菜系</text><button class="link" bindtap="backWizard">调整条件 ›</button></view><view wx:if="{{missing.length}}" class="warning"><text class="b">需补充食材</text><view class="tags"><text wx:for="{{missing}}" wx:key="*this">{{item}}</text></view></view><view class="card supplies-card"><text class="b">本餐所需</text><view wx:if="{{ingredients.length}}" class="supply-group"><text class="small supply-label">食材</text><view class="tags"><text wx:for="{{ingredients}}" wx:key="*this" class="tag">{{item}}</text></view></view><view wx:if="{{seasonings.length}}" class="supply-group"><text class="small supply-label">调料</text><view class="tags"><text wx:for="{{seasonings}}" wx:key="*this" class="tag seasoning-tag">{{item}}</text></view></view></view><view class="card"><view wx:for="{{items}}" wx:key="recipe_id" class="divider" data-id="{{item.recipe_id}}" bindtap="dish"><text class="b">{{item.name}} ›</text><text class="small">{{item.cuisine}} · {{item.spicy_level}} · {{item.salt_level}}</text><view class="recipe-actions"><button wx:if="{{!complete && !fromSaved && !meal.preferences.__blind}}" class="link recipe-lock {{item.locked?'locked':''}}" catchtap="toggleLock" data-id="{{item.recipe_id}}">{{item.locked?'已保留 🔒':'保留'}}</button><button class="link recipe-favorite {{item.favorited?'cancel-link':''}}" catchtap="favorite" data-id="{{item.recipe_id}}">{{item.favorited?'取消收藏':'收藏这道菜'}}</button></view></view></view><view class="result-actions"><button class="btn" bindtap="start">{{complete?'查看菜谱':meal.started?'继续做菜':'开始做菜'}}</button><button wx:if="{{!complete && !fromSaved}}" class="btn secondary" bindtap="refresh" disabled="{{lockedIds.length === items.length && items.length > 0}}">换一份</button><text wx:if="{{!complete && !fromSaved && lockedIds.length === items.length && items.length > 0}}" class="small lock-hint">请先解除一道菜的保留</text></view></view>




</block>
