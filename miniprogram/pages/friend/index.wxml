<view class="main"><view wx:if="{{loading}}" class="small">加载中…</view><view wx:elif="{{error}}" class="card"><text class="small">{{error}}</text><button class="link" bindtap="refresh">重试</button></view><block wx:else><view class="row"><image class="avatar" mode="aspectFill" src="{{profile.avatar || '/assets/pig-chef-avatar.png'}}"/><view><text class="h">{{profile.name}}</text><text class="small">做过 {{achievement.completed}} 道菜 · 收藏 {{menus.length}} 道菜</text></view></view><text class="section-heading">{{selected?'收藏菜单详情':'好友的收藏菜单'}}</text><view wx:if="{{selected}}" class="card"><text class="b">{{selected.date}} · {{selected.people}}人份</text><view wx:for="{{selected.items}}" wx:key="recipe_id" class="divider row" bindtap="dish" data-id="{{item.recipe_id}}"><text>{{item.name}}</text><text>做法 ›</text><button class="link" catchtap="save" data-id="{{item.recipe_id}}" disabled="{{saving}}">收藏这道菜</button></view><button class="link" bindtap="close">返回菜单列表</button></view><block wx:else><view wx:for="{{menus}}" wx:key="key" class="card" bindtap="openMenu" data-id="{{item.id}}" data-recipe="{{item.recipeId}}"><text class="b">{{item.names}} ›</text><text class="small">{{item.date}} · {{item.people}}人份</text></view><text wx:if="{{!menus.length}}" class="empty">好友还没有收藏菜单</text></block></block></view>
