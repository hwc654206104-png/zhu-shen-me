/* 我的菜单：清晰的日期层级与操作区 */
.main{padding-top:34rpx;padding-left:32rpx;padding-right:32rpx;padding-bottom:100rpx}
.brand-lockup{display:flex;align-items:center;gap:14rpx;margin-bottom:18rpx}
.brand-mark{width:58rpx;height:58rpx;border-radius:18rpx}
.brand-name{font-size:33rpx;font-weight:700;color:#2e4033}
.eyebrow{display:block;font-size:23rpx;color:#7b8b73;letter-spacing:2rpx;margin-top:20rpx}
.h{font-size:48rpx;margin:6rpx 0 28rpx;color:#24372a}
.card{padding:0 28rpx;margin:18rpx 0;border-radius:26rpx;border-color:#e4e9df;background:#fff}
.menu-toggle{min-height:110rpx;padding:0}
.menu-toggle .b{font-size:33rpx}
.menu-arrow{width:68rpx;height:68rpx;line-height:64rpx;border-radius:50%;background:#f0f4ea;font-size:40rpx}
.menu-entry{padding:24rpx 0;border-top:1rpx solid #edf1e9}
.menu-entry>.b{font-size:29rpx;color:#2e4033;margin-bottom:7rpx}
.menu-entry>.small{font-size:24rpx;color:#7a8878;line-height:1.55}
.menu-actions{display:flex;justify-content:flex-end;align-items:center;gap:4rpx;margin-top:12rpx}
.menu-actions .link,.menu-entry>.link{min-height:72rpx;font-size:27rpx;padding:6rpx 20rpx;border-radius:14rpx;background:#f1f5ec}
.menu-actions .danger-link,.menu-entry>.danger-link{color:#a94d42;background:#fff1ee}
.empty-state{padding:54rpx 28rpx;text-align:center;border-radius:28rpx}
.cancel-link{color:#b34f43!important;background:#fff0ed!important}
.menu-entry .menu-actions{display:flex;flex-direction:row;flex-wrap:nowrap;justify-content:flex-start;gap:10rpx}.menu-entry .menu-actions .link{flex:0 0 auto;width:auto}
.menu-entry>.row{display:flex;flex-direction:row;flex-wrap:nowrap;justify-content:flex-start;gap:10rpx}.menu-entry>.row .link{flex:0 0 auto;width:auto}
