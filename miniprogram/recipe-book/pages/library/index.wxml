<view class="main"><text class="h">菜谱大全</text><input class="input" placeholder="搜索菜名或食材" value="{{query}}" bindinput="search"/><view class="tags"><text wx:for="{{categories}}" wx:key="*this" class="tag {{category===item?'active':''}}" data-category="{{item}}" bindtap="category">{{item}}</text></view><text class="small">共 {{count}} 道</text><view wx:for="{{rows}}" wx:key="id" class="card row" data-id="{{item.id}}" bindtap="open"><text class="b">{{item.name}}</text><text class="small">{{item.category}} ›</text></view><text wx:if="{{!rows.length}}" class="small">没有找到相关菜谱，试试其他名称</text></view>
