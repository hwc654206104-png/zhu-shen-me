<view class="main"><view class="brand-lockup"><image class="brand-mark" mode="aspectFit" src="/assets/pig-chef-avatar.png"/><text class="brand-name">猪什么</text></view><text class="eyebrow">已保存的餐桌</text><text class="h">我的菜单</text><view class="card"><view class="row menu-toggle" bindtap="toggleDoing"><text class="b">正在做 · {{ongoing.length}}</text><text class="menu-arrow">{{doingOpen?'⌃':'⌄'}}</text></view><block wx:if="{{doingOpen}}"><view wx:for="{{ongoing}}" wx:key="id" class="divider menu-entry" data-id="{{item.id}}" bindtap="open"><text class="b">{{item.displayTitle}}</text><text class="small">{{item.names}} · {{item.done.length}}/{{item.ids.length}}</text><view class="menu-actions"><button class="link" data-id="{{item.id}}" catchtap="continueCooking">继续做 ›</button><button class="link danger-link" data-id="{{item.id}}" catchtap="endCooking">结束本次</button></view></view></block></view><view class="card"><view class="row menu-toggle" bindtap="toggleCompleted"><text class="b">已完成 · {{completed.length}}</text><text class="menu-arrow">{{completedOpen?"⌃":"⌄"}}</text></view><block wx:if="{{completedOpen}}"><view wx:for="{{completed}}" wx:key="id" class="divider menu-entry" data-id="{{item.id}}" bindtap="open"><text class="b">{{item.displayTitle}}</text><text class="small">{{item.names}}</text><view class="row menu-actions"><button class="link" data-id="{{item.id}}" catchtap="open">查看菜单</button><button class="link danger-link" data-id="{{item.id}}" catchtap="deleteMeal">删除</button></view></view></block></view><view class="card"><view class="row menu-toggle" bindtap="toggleSaved"><text class="b">我的收藏 · {{saved.length}}</text><text class="menu-arrow">{{savedOpen?'⌃':'⌄'}}</text></view><block wx:if="{{savedOpen}}"><text class="small">收藏菜谱对好友可见，备注仅自己可见</text><view wx:for="{{saved}}" wx:key="recipeId" class="divider menu-entry" data-recipe="{{item.recipeId}}" bindtap="openFavorite"><text class="b">{{item.name}}</text><text wx:if="{{item.note}}" class="small">{{item.note}}</text><view class="row"><button class="link" data-recipe="{{item.recipeId}}" catchtap="openFavorite">查看做法</button><button class="link" data-recipe="{{item.recipeId}}" catchtap="edit">编辑备注</button><button class="link cancel-link" data-recipe="{{item.recipeId}}" catchtap="remove">取消收藏</button></view></view></block></view></view>
