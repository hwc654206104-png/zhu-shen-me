<view wx:if="{{remoteError}}" class="main"><text class="small">{{remoteError}}</text></view><block wx:else><view class="main"><text class="eyebrow">跟着学做</text><text class="h">{{recipe.source_title || recipe.name}}</text><view wx:if="{{sourceVersions.length}}" class="tags"><text wx:for="{{sourceVersions}}" wx:key="index" class="tag {{sourceIndex===index?'active':''}}" data-index="{{index}}" bindtap="chooseSource">{{item.label}}</text></view><view class="tags"><text class="tag">{{recipe.cuisine}}</text><text class="tag">{{recipe.dish_category}}</text><text class="tag">{{recipe.spicy_level}} · {{recipe.salt_level}}</text><text wx:for="{{recipe.flavor_tags}}" wx:key="*this" class="tag">{{item}}</text></view><text wx:if="{{!sourceOriginal}}" class="small">{{meal.people}}人份 · 约{{minutes}}分钟 · {{readOnly?(catalog?"查看菜谱":"好友收藏"):allDone?"已完成":meal.started?"正在做":"查看菜谱"}}</text><view wx:if="{{!catalog}}" class="progress"><text class="small">当前第 {{currentIndex+1}} / {{meal.ids.length}} 道菜 · 已完成 {{meal.done.length}} 道</text><progress wx:if="{{!readOnly}}" percent="{{percent}}" activeColor="#537348" stroke-width="6"/><view class="tags"><text wx:for="{{track}}" wx:key="id" class="tag {{item.id===recipe.recipe_id?'active':''}}" data-id="{{item.id}}" bindtap="view">{{item.done?'✓ ':''}}{{item.name}}</text></view></view><view class="card"><text class="b">准备食材</text><block wx:if="{{sourceOriginal}}"><view class="tags"><text wx:for="{{sourceFoods}}" wx:key="*this" class="tag">{{item}}</text></view><text wx:if="{{sourceOptional.length}}" class="b section-label">可选配料</text><view wx:if="{{sourceOptional.length}}" class="tags"><text wx:for="{{sourceOptional}}" wx:key="*this" class="tag">{{item}}（可选）</text></view><text wx:if="{{sourceSeasonings.length}}" class="b section-label">所需调料</text><view class="tags"><text wx:for="{{sourceSeasonings}}" wx:key="*this" class="tag">{{item}}</text></view><view class="source-toggle" bindtap="toggleSource"><text class="b">用量与完整配料</text><text class="small">{{sourceOpen?'收起 −':'展开 ＋'}}</text></view><text class="small">原谱用量需按实际食材重量调整</text><view wx:if="{{sourceOpen}}"><text class="small source-text">{{recipe.source_ingredients}}</text><text class="b section-label">原谱用量</text><text wx:for="{{sourceAmounts}}" wx:key="index" class="small amount-line">{{item}}</text></view></block><text wx:if="{{!sourceOriginal}}" wx:for="{{ingredients}}" wx:key="name" class="small">{{item.name}} {{item.amount}}</text></view><view class="card"><text class="b">跟着学做</text><view wx:for="{{steps}}" wx:key="index" class="divider"><text wx:if="{{item.heading}}" class="b section-label">{{item.heading}}</text><view class="row recipe-step" data-index="{{index}}" bindtap="expand"><text class="tag">{{item.stepNumber || index+1}}</text><text class="small {{sourceOriginal?'source-text':''}}">{{item.instruction}}</text></view><view wx:if="{{item.open}}" class="step-guide"><text class="small">火候：{{item.heat}}</text><text wx:if="{{item.minutes!==null}}" class="small">时间：{{item.minutes}}分钟</text><text class="small">{{item.materialText}}</text></view></view></view><view wx:if="{{sourceOriginal}}" class="card"><view class="source-toggle" bindtap="toggleExtra"><text class="b">烹饪提示</text><text class="small">{{extraOpen?'收起 −':'展开 ＋'}}</text></view><text wx:if="{{extraOpen}}" class="small source-text">{{recipe.source_extra || '暂无额外提示'}}</text><text wx:if="{{extraOpen && sourceNotes}}" class="small source-text">{{sourceNotes}}</text><text wx:if="{{!recipe.hide_source_credit}}" class="small source-credit">来源：{{sourceCredit}} · {{sourceLicense}}</text><text wx:if="{{extraOpen && sourceLicenseNotice}}" class="small source-text">{{sourceLicenseNotice}}</text></view><button wx:if="{{catalog || !readOnly}}" class="btn secondary" bindtap="favoriteCatalog">{{catalogFavorited?'取消收藏':'收藏这道菜'}}</button><button wx:if="{{!readOnly && !allDone && !meal.started}}" class="btn" bindtap="start">开始做菜</button><button wx:if="{{!readOnly && !allDone && meal.started}}" class="btn" bindtap="finish">{{isDone?'取消完成':'完成这道菜'}}</button><view wx:if="{{!readOnly && allDone}}" class="complete-card"><text class="b">本餐已全部完成</text><text class="small">要把用过的食材从冰箱移除吗？可不选。</text><checkbox-group class="cleanup-list" bindchange="cleanupChange"><label wx:for="{{cleanupFoods}}" wx:key="id" class="cleanup-item"><checkbox value="{{item.id}}" disabled="{{!item.owned}}" checked="{{item.selected}}" color="#537348"/><text>{{item.name}}{{item.owned?'':'（未在冰箱）'}}</text></label></checkbox-group><view class="row cleanup-actions"><button class="link" bindtap="selectAllCleanup">{{cleanupSelected.length===cleanupSelectableCount&&cleanupSelectableCount?'取消全选':'全选'}}</button><button class="btn finish-btn" bindtap="cleanup">完成并返回首页</button></view></view></view>


</block>