<view class="page"><text class="title">我的好友</text><view wx:if="{{error}}" class="error">{{error}}<text bindtap="refresh"> · 重试</text></view><view wx:if="{{achievement}}" class="card invitation-card"><text class="name">一起学做饭</text><text class="meta">对方做过 {{achievement.completed}} 道菜</text><view class="invitation-actions"><button class="primary" bindtap="accept" disabled="{{busy}}" loading="{{busy}}">添加好友</button><button class="link" bindtap="decline">暂不添加</button></view></view><view wx:for="{{friends}}" wx:key="id" class="card"><navigator class="friend-card" url="/pages/friend/index?friend={{item.id}}" open-type="navigate" bindtap="noteFriendTap" bindsuccess="friendNavigationSuccess" bindfail="friendNavigationFailed" hover-class="friend-card-active"><view class="friend"><image class="avatar" mode="aspectFill" src="{{item.profile.avatar || '/assets/pig-chef-avatar.png'}}"/><view><text class="name">{{item.profile.name}}</text><text class="meta">做过 {{item.achievement.completed}} 道菜 · 收藏 {{item.achievement.favorites}} 个菜单</text></view></view></navigator><view class="friend-actions"><navigator class="view-menu" url="/pages/friend/index?friend={{item.id}}" open-type="navigate" bindtap="noteFriendTap" bindsuccess="friendNavigationSuccess" bindfail="friendNavigationFailed" hover-class="friend-card-active">查看收藏菜单 ›</navigator><button class="link" catchtap="remove" data-id="{{item.id}}">解除好友</button></view></view><view wx:if="{{!friends.length && !achievement}}" class="empty">邀请朋友，一起记录下厨进步</view><button wx:if="{{!invite}}" class="primary" bindtap="prepare" disabled="{{busy}}" loading="{{busy}}">邀请好友</button><view wx:else><button class="primary" open-type="share">分享给微信好友</button><button class="add-friend" bindtap="copy">复制邀请码</button></view><button class="add-friend" bindtap="openCodeForm">通过邀请码添加好友</button><view wx:if="{{showCodeForm}}" class="code-mask"><view class="code-dialog"><text class="dialog-title">添加好友</text><textarea class="code-input" value="{{code}}" bindinput="updateCode" maxlength="140" placeholder="粘贴好友邀请码" focus="{{showCodeForm}}" auto-height="{{false}}"/><text wx:if="{{codeError}}" class="error">{{codeError}}</text><view class="code-actions"><button class="link code-cancel" bindtap="closeCodeForm" disabled="{{busy}}">取消</button><button class="primary code-next" bindtap="previewCode" loading="{{busy}}" disabled="{{busy}}">下一步</button></view></view></view><text class="version" bindlongpress="copyDiagnostics">v{{version}}</text></view>
